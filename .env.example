VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Hauling Stripe TEST only (not Best Sea to Sky). Rick has not created the
# account yet. Leave these blank. Do not invent or commit real keys.

# Server only (Vercel POST /api/stripe/webhook + Edge Functions).
# Never put sk_ or whsec in any VITE_ variable.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Client publishable key (pk_test only). Publishable is OK in the Vite client.
VITE_STRIPE_PUBLISHABLE_KEY=

# Conceptual Fenrir/Next name. This repo is Vite, not Next. Do not use this
# name. Map it to VITE_STRIPE_PUBLISHABLE_KEY above.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional server copy of the same pk_test key for create-onsite-payment-intent.
# STRIPE_PUBLISHABLE_KEY=

# Required on the Vercel webhook so it can write org-scoped payment rows.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional invoice-copy email after a paid on-site charge. Not Path B.
# RESEND_API_KEY=
# RECEIPT_FROM_EMAIL=
