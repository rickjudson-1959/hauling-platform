VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Hauling Stripe TEST account only (not Best Sea to Sky). Rick has not created
# the account yet. Leave placeholders. Do not invent or commit real keys.
#
# Server only (Vercel /api/stripe/webhook + Supabase Edge Functions).
# Never put sk_ or whsec in any VITE_ variable.
# STRIPE_SECRET_KEY=sk_test_replace_me
# STRIPE_WEBHOOK_SECRET=whsec_replace_me
#
# Client publishable key (pk_test only). Fenrir listed
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY as the conceptual client key; this Vite
# app maps that to VITE_STRIPE_PUBLISHABLE_KEY.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
#
# Optional server copy of the same publishable key, returned by
# create-onsite-payment-intent if the Vite var is unset.
# STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
#
# Required on the Vercel webhook so it can write org-scoped payment rows.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
#
# Optional: invoice-copy email after a paid on-site charge. Stripe still
# emails its own receipt when the customer has an email (receipt_email).
# RESEND_API_KEY=re_replace_me
# RECEIPT_FROM_EMAIL=Hauling Receipts <receipts@your-domain.com>
