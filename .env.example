VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Stripe TEST keys for the dedicated Hauling account (NOT Best Sea to Sky).
# Set these as Supabase Edge Function secrets. Never put Stripe secret keys
# in Vite (no VITE_STRIPE_SECRET_KEY). The publishable key is returned to the
# driver app by create-onsite-payment-intent.
#
# STRIPE_SECRET_KEY=sk_test_replace_me
# STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# STRIPE_WEBHOOK_SECRET=whsec_replace_me
#
# Optional: invoice-copy email after a paid on-site charge. Stripe still
# emails its own receipt when the customer has an email (receipt_email).
# RESEND_API_KEY=re_replace_me
# RECEIPT_FROM_EMAIL=Hauling Receipts <receipts@your-domain.com>
